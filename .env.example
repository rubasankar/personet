# CognoDB (Neo4j-compatible) connection URI
# Local:       bolt://localhost:7687
# CognoDB Cloud: bolt+s://<host>:<port>
COGNODB_URI=bolt://localhost:7687

# CognoDB username
COGNODB_USER=neo4j

# CognoDB password
COGNODB_PASSWORD=changeme

# Secret key used to sign and verify JWT tokens - use a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# JWT signing algorithm (leave as HS256)
JWT_ALGORITHM=HS256

# How long a JWT stays valid (minutes)
JWT_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Deployment - set these on your hosting platform, not in this file
# ---------------------------------------------------------------------------

# Set to "production" on the hosting platform.
# Controls: cookie secure=True, CORS origin enforcement.
ENVIRONMENT=development

# Allowed frontend origin for CORS.
# Local default is http://localhost:3000.
# In production set this to your deployed frontend URL, e.g.:
#   FRONTEND_URL=https://pernet.vercel.app
FRONTEND_URL=http://localhost:3000
